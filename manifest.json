{
  "manifest_version": 2,
  "name": "Search Results in New Tab",
  "version": "1.0",
  "description": "Opens clicked search results (Google, DuckDuckGo) in a new tab instead of the current one.",
  "browser_specific_settings": {
    "gecko": {
      "id": "search-results-newtab@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/on/icon-16.png",
    "32": "icons/on/icon-32.png",
    "48": "icons/on/icon-48.png",
    "96": "icons/on/icon-96.png",
    "128": "icons/on/icon-128.png"
  },
  "browser_action": {
    "default_title": "Search results in new tab (click to toggle on/off)",
    "default_icon": {
      "16": "icons/on/icon-16.png",
      "32": "icons/on/icon-32.png",
      "48": "icons/on/icon-48.png",
      "96": "icons/on/icon-96.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.google.co.uk/search*",
        "*://*.google.co.il/search*",
        "*://*.google.de/search*",
        "*://*.google.fr/search*",
        "*://*.google.ca/search*",
        "*://*.google.com.au/search*",
        "*://*.google.co.in/search*",
        "*://*.google.co.jp/search*",
        "*://*.google.es/search*",
        "*://*.google.it/search*",
        "*://*.google.nl/search*",
        "*://*.google.com.br/search*",
        "*://*.google.com.mx/search*",
        "*://duckduckgo.com/*",
        "*://html.duckduckgo.com/*",
        "*://lite.duckduckgo.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
